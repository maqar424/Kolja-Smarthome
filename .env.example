# Copy to .env and fill in. .env is never committed.

# MQTT broker (mosquitto on the Pi). In the container on the Pi use the Pi's LAN IP too.
MQTT_HOST=192.168.0.X
MQTT_PORT=1883
Z2M_BASE_TOPIC=zigbee2mqtt

# Safety switches – keep these defaults during development.
# DRY_RUN=true: MQTT commands are only logged, never published.
DRY_RUN=true
# In dry run, also allow the read-only state requests (<lamp>/get) at startup?
# They change nothing, but they are messages to the lamps. pveSwitch never gets one.
DRY_RUN_ALLOW_READS=false
# BUTTONS_ENABLED=false: wall switches / kettle button are ignored (old smarthome_hub still active).
BUTTONS_ENABLED=false

# Web server
HTTP_PORT=8000

# Where SQLite lives (mounted volume in the container)
DATA_DIR=./data

# Log level: DEBUG, INFO, WARNING
LOG_LEVEL=INFO
